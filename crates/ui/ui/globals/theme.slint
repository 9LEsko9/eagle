export struct Tokens { bg: color, surf: color, tx: color, tx2: color, ln: color }
export enum ThemeMode { auto, graphite, paper, oled }
export global Theme {
    callback palette-changed();
    in-out property <int> tint: 1;
    changed tint => { Theme.palette-changed(); }
    changed t => { Theme.palette-changed(); }
    in-out property <ThemeMode> mode: ThemeMode.auto;
    // Set from winit after window creation: Palette access in this global panics during Slint 1.17 initialization.
    in property <bool> system-dark: true;
    private property <Tokens> graphite: { bg: #121214, surf: #1a1a1d, tx: #f2f2f4, tx2: #9d9da4, ln: #26262a };
    private property <Tokens> paper: { bg: #fafaf7, surf: #f1f1ec, tx: #151517, tx2: #5c5c61, ln: #e4e4de };
    private property <Tokens> oled: { bg: #000, surf: #0e0e10, tx: #fff, tx2: #9c9ca3, ln: #1a1a1d };
    out property <Tokens> t: mode == ThemeMode.graphite ? graphite : mode == ThemeMode.paper ? paper : mode == ThemeMode.oled ? oled : system-dark ? graphite : paper;
}
export global Motion {
    in-out property <bool> reduced;
    out property <duration> fast: reduced ? 0ms : 200ms;
    out property <duration> base: reduced ? 0ms : 300ms;
    out property <duration> slow: reduced ? 0ms : 550ms;
}
export global Type {
    in-out property <float> scale: 1;
    out property <length> small: 12px * scale;
    out property <length> body: 14px * scale;
    out property <length> title: 20px * scale;
}
