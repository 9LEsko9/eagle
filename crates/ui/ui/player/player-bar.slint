import { Theme, Type, Motion } from "../globals/theme.slint";
import { Player, Ui, Actions, Status } from "../globals/bridge.slint";
import { Cover } from "../components/cover.slint";
import { IconButton } from "../components/icon-button.slint";
import { PlayPause } from "../components/play-pause.slint";
import { SeekSlider } from "../components/slider.slint";
export component PlayerBar inherits Rectangle {
    height: 84px;
    background: Player.colors.bar;
    animate background { duration: Motion.slow; }
    Timer { interval: 250ms; running: Player.status == Status.playing && Ui.visible-to-user; triggered => { Player.shown = Player.position(); } }
    HorizontalLayout {
        padding-left: 24px; padding-right: 24px; padding-top: 6px; padding-bottom: 6px; spacing: 12px;
        Cover { image: Player.cover; fg: Player.colors.tx; clicked => { Ui.panel-open = !Ui.panel-open; } }
        VerticalLayout {
            min-width: 100px; max-width: 180px; horizontal-stretch: 1; spacing: 2px; alignment: center;
            Text { text: Player.title == "" ? @tr("Ничего не играет") : Player.title; color: Player.colors.tx; font-size: Type.body; overflow: elide; }
            Text { text: Player.status == Status.loading ? @tr("Загрузка…") : Player.status == Status.buffering ? @tr("Буферизация…") : Player.artist; color: Player.colors.tx2; font-size: Type.small; overflow: elide; }
        }
        IconButton { icon: @image-url("../icons/heart.svg"); active-icon: @image-url("../icons/heart-filled.svg"); show-mark: false; label: @tr("Нравится"); active: Player.liked; fg: Player.colors.tx2; clicked => { Actions.like(Player.track-id); } }
        VerticalLayout {
            horizontal-stretch: 2; max-width: 560px; spacing: 0px;
            HorizontalLayout { alignment: center; spacing: 14px;
        IconButton { icon: @image-url("../icons/shuffle.svg"); label: @tr("Перемешивание"); active: Player.shuffle; fg: Player.colors.tx; clicked => { Actions.toggle-shuffle(); } }
        IconButton { icon: @image-url("../icons/previous.svg"); label: @tr("Предыдущий трек"); fg: Player.colors.tx; clicked => { Actions.prev(); } }
        PlayPause { playing: Player.status == Status.playing; fg: Player.colors.tx; clicked => { Actions.toggle-play(); } }
        IconButton { icon: @image-url("../icons/next.svg"); label: @tr("Следующий трек"); fg: Player.colors.tx; clicked => { Actions.next(); } }
        IconButton { icon: @image-url("../icons/repeat.svg"); label: Player.repeat == 2 ? @tr("Повтор одного трека") : @tr("Повтор"); active: Player.repeat > 0; fg: Player.colors.tx; clicked => { Actions.cycle-repeat(); } }
            }
            HorizontalLayout {
                spacing: 10px;
                Text { text: floor(Player.shown / 60) + ":" + (mod(floor(Player.shown), 60) < 10 ? "0" : "") + mod(floor(Player.shown), 60); color: Player.colors.tx2; font-size: 11px; min-width: 30px; vertical-alignment: center; }
                SeekSlider { label: @tr("Позиция"); fg: Player.colors.tx; value: Player.length > 0 ? Player.shown / Player.length : 0; changed(f) => { Actions.seek(Player.length * f); } }
                Text { text: floor(Player.length / 60) + ":" + (mod(floor(Player.length), 60) < 10 ? "0" : "") + mod(floor(Player.length), 60); color: Player.colors.tx2; font-size: 11px; min-width: 30px; vertical-alignment: center; }
            }
        }
        Rectangle { width: 32px; }
        Image { source: @image-url("../icons/volume.svg"); colorize: Player.colors.tx; width: 18px; height: 18px; }
        SeekSlider { width: 80px; label: @tr("Громкость"); fg: Player.colors.tx; value: Player.volume; changed(v) => { Actions.set-volume(v); } }
    }
}
