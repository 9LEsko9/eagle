import { ListView } from "std-widgets.slint";
import { Theme, Type, Motion } from "../globals/theme.slint";
import { Player, Library, Ui, Actions } from "../globals/bridge.slint";
import { IconButton } from "../components/icon-button.slint";
export component NowPlayingPanel inherits Rectangle {
    width: Ui.panel-open ? 320px : 0px;
    animate width { duration: Motion.slow; easing: ease-in-out; }
    if Ui.panel-open : Rectangle {
        x: 0px; y: 16px; width: parent.width - 16px; height: min(parent.height - 32px, 650px);
        border-radius: 16px;
        background: Player.colors.bg;
        animate background { duration: Motion.slow; }
        VerticalLayout {
            padding: 20px; spacing: 10px;
            HorizontalLayout {
                Text { text: @tr("Сейчас играет"); color: Player.colors.tx2; font-size: Type.small; font-weight: 600; vertical-alignment: center; }
                IconButton { icon: @image-url("../icons/close.svg"); label: @tr("Скрыть панель"); fg: Player.colors.tx2; clicked => { Ui.panel-open = false; } }
            }
            Image { source: Player.cover; height: 264px; image-fit: contain; }
            HorizontalLayout {
                padding-top: 8px;
                VerticalLayout {
                    spacing: 2px;
                    Text { text: Player.title; color: Player.colors.tx; font-size: 19px * Type.scale; font-weight: 700; overflow: elide; }
                    Text { text: Player.artist; color: Player.colors.tx2; font-size: Type.body; overflow: elide; }
                }
                IconButton { icon: @image-url("../icons/heart.svg"); active-icon: @image-url("../icons/heart-filled.svg"); show-mark: false; label: @tr("Нравится"); active: Player.liked; fg: Player.colors.tx2; clicked => { Actions.like(Player.track-id); } }
            }
            Text { text: Player.source; color: Player.colors.tx2; font-size: Type.small; }
            Text { text: @tr("Далее"); color: Player.colors.tx2; font-size: Type.small; font-weight: 600; height: 32px; vertical-alignment: bottom; }
            ListView {
                for item in Library.queue : Rectangle {
                    height: 44px;
                    VerticalLayout {
                        spacing: 2px; alignment: center;
                        Text { text: item.title; color: Player.colors.tx; font-size: 13px * Type.scale; overflow: elide; }
                        Text { text: item.artist; color: Player.colors.tx2; font-size: Type.small; overflow: elide; }
                    }
                }
            }
        }
    }
}
