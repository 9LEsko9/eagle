import { Theme, Type, Motion } from "../globals/theme.slint";
import { CardItem, Actions, Route } from "../globals/bridge.slint";
import { Artwork } from "cover.slint";

// Filter chips; the chosen one is filled with the text colour (mockup «Медиатека»).
export component Chips inherits HorizontalLayout {
    in property <[string]> options;
    in property <int> selected;
    callback picked(int);
    spacing: 8px;
    alignment: start;
    for option[index] in root.options : Rectangle {
        height: 32px;
        min-width: label.preferred-width + 28px;
        border-radius: 16px;
        background: index == root.selected ? Theme.t.tx : touch.has-hover ? Theme.hover : transparent;
        border-width: index == root.selected ? 0px : 1px;
        border-color: Theme.t.ln;
        private property <float> scale: touch.pressed ? 0.96 : 1;
        animate background { duration: Motion.fast; }
        animate scale { duration: Motion.fast; easing: cubic-bezier(0.2, 0, 0, 1); }
        transform-scale-x: self.scale * 100%;
        transform-scale-y: self.scale * 100%;
        accessible-role: button;
        accessible-label: option;
        accessible-checked: index == root.selected;
        accessible-action-default => { root.picked(index); }
        label := Text {
            text: option;
            color: index == root.selected ? Theme.t.bg : Theme.t.tx;
            font-size: Type.meta;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.picked(index); }
        }
    }
}

component Tile inherits Rectangle {
    in property <CardItem> card;
    in property <length> art;
    private property <float> scale: touch.pressed ? 0.96 : 1;
    animate scale { duration: Motion.fast; easing: cubic-bezier(0.2, 0, 0, 1); }
    accessible-role: button;
    accessible-label: card.title;
    accessible-action-default => { root.open(); }
    function open() {
        Actions.collection(root.card.route, root.card.id);
    }
    Artwork {
        x: 0;
        y: 0;
        width: root.art;
        height: root.art;
        radius: root.card.round ? root.art / 2 : 8px;
        image: root.card.cover;
        transform-scale-x: root.scale * 100%;
        transform-scale-y: root.scale * 100%;
        // A light wash on hover instead of a translucent overlay layer.
        Rectangle { background: touch.has-hover ? #ffffff14 : transparent; animate background { duration: Motion.fast; } }
    }
    Text {
        x: 0;
        y: root.art + 8px;
        height: 20px;
        vertical-alignment: top;
        width: root.width;
        text: root.card.title;
        color: Theme.t.tx;
        font-size: Type.body;
        font-weight: 600;
        overflow: elide;
        horizontal-alignment: root.card.round ? center : left;
    }
    Text {
        x: 0;
        y: root.art + 29px;
        height: 18px;
        vertical-alignment: top;
        width: root.width;
        text: root.card.subtitle;
        color: Theme.t.tx2;
        font-size: Type.meta;
        overflow: elide;
        horizontal-alignment: root.card.round ? center : left;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
    }
}

// Absolutely placed grid with no layout pass per frame. It reports which cards are on
// screen (`top` = how far the grid is scrolled past the viewport top) so artwork loads
// only for those.
export component CardGrid inherits Rectangle {
    in property <[CardItem]> cards;
    in property <length> top;
    in property <length> view-height;
    private property <length> gap: 20px;
    out property <int> columns: max(2, floor((self.width + gap) / (176px + gap)));
    private property <length> art: (self.width - (columns - 1) * gap) / columns;
    out property <length> row-height: art + 52px + gap;
    private property <int> first-row: min(ceil(root.cards.length / root.columns), floor(max(0px, root.top) / root.row-height));
    private property <int> visible-rows: max(0, min(ceil(root.cards.length / root.columns), ceil((root.top + root.view-height) / root.row-height)) - root.first-row);
    out property <int> start: max(0, root.first-row - 1) * root.columns;
    out property <int> instantiated-count: root.visible-rows == 0 ? 0 : max(0, min(root.cards.length - root.start, (root.visible-rows + 2) * root.columns));
    callback anchor-changed(length);
    private property <int> previous-columns;
    private property <length> previous-row-height;
    function report() {
        Actions.visible-cards(root.start, root.instantiated-count);
    }
    height: ceil(cards.length / columns) * row-height;
    init => { root.previous-columns = root.columns; root.previous-row-height = root.row-height; root.report(); }
    changed first-row => { root.report(); }
    changed width => {
        if root.previous-row-height > 0px {
            root.anchor-changed(floor(floor(max(0px, root.top) / root.previous-row-height) * root.previous-columns / root.columns) * root.row-height);
        }
        root.previous-columns = root.columns;
        root.previous-row-height = root.row-height;
        root.report();
    }
    changed columns => { root.report(); }
    changed visible-rows => { root.report(); }
    changed height => { root.report(); }
    for offset in root.instantiated-count : Tile {
        private property <int> index: root.start + offset;
        card: root.cards[self.index];
        art: root.art;
        x: mod(self.index, root.columns) * (root.art + root.gap);
        y: floor(self.index / root.columns) * root.row-height;
        width: root.art;
        height: root.art + 52px;
    }
}
