import { Theme, Type } from "../globals/theme.slint";
import { TrackItem, Actions, Player, Route } from "../globals/bridge.slint";
import { TextButton } from "button.slint";
import { IconButton } from "icon-button.slint";
export component TrackRowView inherits Rectangle {
    in property <TrackItem> item;
    in property <int> number;
    private property <bool> hovered: touch.has-hover || heart.hovered || more.hovered || play-control.hovered;
    height: 54px;
    border-radius: 8px;
    accessible-role: list-item; accessible-label: item.title + ", " + item.artist;
    accessible-action-default => { if item.available { Actions.play(item.id); } }
    background: root.hovered || focus.has-focus ? Theme.t.surf : transparent;
    border-width: focus.has-focus ? 2px : 0px; border-color: Theme.t.tx;
    forward-focus: focus;
    focus := FocusScope { key-pressed(e) => { if e.text == "\n" && root.item.available { Actions.play(root.item.id); return accept; } return reject; } }
    touch := TouchArea { clicked => { focus.focus(); } double-clicked => { if root.item.available { Actions.play(root.item.id); } } }
    HorizontalLayout {
        padding-left: 10px; padding-right: 8px; spacing: 12px;
        Rectangle {
            width: 40px;
            Text { text: root.number; color: Theme.t.tx2; font-size: Type.small; horizontal-alignment: center; vertical-alignment: center; opacity: root.hovered || focus.has-focus ? 0 : 1; }
            play-control := IconButton { icon: @image-url("../icons/play.svg"); label: @tr("Играть трек"); reveal: root.hovered || focus.has-focus; clicked => { if root.item.available { Actions.play(root.item.id); } } }
        }
        VerticalLayout {
            horizontal-stretch: 2; spacing: 2px; alignment: center;
            Text { text: item.title; color: item.available ? Theme.t.tx : Theme.t.tx2; font-size: Type.body; font-weight: item.id == Player.track-id ? 600 : 500; overflow: elide; }
            Text { text: item.artist; color: Theme.t.tx2; font-size: 13px * Type.scale; overflow: elide; }
        }
        heart := IconButton { icon: @image-url("../icons/heart.svg"); active-icon: @image-url("../icons/heart-filled.svg"); show-mark: false; label: @tr("Нравится"); active: root.item.liked; reveal: root.item.liked || root.hovered || focus.has-focus; clicked => { Actions.like(root.item.id); } }
        more := IconButton { icon: @image-url("../icons/more.svg"); label: @tr("Ещё"); reveal: root.hovered || focus.has-focus; clicked => { menu.show(); } }
        Text { width: 44px; text: item.duration; color: Theme.t.tx2; font-size: Type.small; horizontal-alignment: right; vertical-alignment: center; }
    }
    menu := PopupWindow {
        x: parent.width - self.width; y: 40px; width: 180px; height: 80px;
        Rectangle { background: Theme.t.surf;
        VerticalLayout {
            TextButton { text: @tr("Нравится"); clicked => { Actions.like(root.item.id); menu.close(); } }
            if root.item.album-id != "" : TextButton { text: @tr("Открыть альбом"); clicked => { Actions.collection(Route.album, root.item.album-id); menu.close(); } }
        } }
    }
}
