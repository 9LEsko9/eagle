// SPDX-License-Identifier: GPL-3.0-or-later
import { Theme, Type } from "../globals/theme.slint";
import { TrackItem, Actions, Player, Route, Status, Ui } from "../globals/bridge.slint";
import { IconButton } from "icon-button.slint";
import { Artwork } from "cover.slint";
import { GlyphSwap } from "glyph-swap.slint";

// Column widths shared with the table header.
export global TrackColumns {
    out property <length> number: 40px;
    out property <length> row-height: Ui.compact ? 42px : 54px;
    out property <length> actions: 66px;
    out property <length> time: 44px;
    out property <length> gap: 12px;
    out property <length> inset: 10px;
}

// Kept deliberately light: rows are created while scrolling, so no popups, conditional
// sub-trees or animations live here. The «ещё» menu is shared by the whole list.
export component TrackRowView inherits Rectangle {
    in property <TrackItem> item;
    in property <int> number;
    in property <bool> show-album;
    // Asks the list to open the shared «ещё» menu for this row.
    callback menu(TrackItem);
    private property <bool> lit: touch.has-hover || heart.hovered || heart.focused || more.hovered || more.focused || play-control.hovered || play-control.focused || focus.has-focus;
    private property <bool> current: item.id != "" && item.id == Player.track-id;
    height: TrackColumns.row-height;
    border-radius: 8px;
    accessible-role: list-item;
    accessible-label: item.title + ", " + item.artist + (item.blocked-reason != "" ? ", " + item.blocked-reason : "");
    accessible-action-default => { if item.available { Actions.play-row(root.number - 1); } }
    background: root.lit ? Theme.t.surf : transparent;
    forward-focus: focus;
    focus := FocusScope { key-pressed(e) => { if e.text == "\n" && root.item.available { Actions.play-row(root.number - 1); return accept; } return reject; } }
    touch := TouchArea { double-clicked => { if root.item.available { Actions.play-row(root.number - 1); } } }
    HorizontalLayout {
        padding-left: TrackColumns.inset;
        padding-right: TrackColumns.inset;
        spacing: TrackColumns.gap;
        Rectangle {
            width: TrackColumns.number;
            Text {
                text: root.number;
                color: Theme.t.tx2;
                font-size: Type.meta;
                horizontal-alignment: center;
                vertical-alignment: center;
                visible: !root.current && !root.lit;
            }
            Image {
                source: @image-url("../icons/speaker.svg");
                colorize: Theme.t.tx;
                width: 16px;
                height: 16px;
                visible: root.current && !root.lit;
            }
            play-control := IconButton {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                icon-size: 0px;
                label: @tr("Играть трек");
                reveal: root.lit;
                clicked => { if root.item.available { if root.current { Actions.toggle-play(); } else { Actions.play-row(root.number - 1); } } }
            }
            GlyphSwap {
                x: play-control.x;
                y: play-control.y;
                width: play-control.width;
                height: play-control.height;
                on: root.current && Player.status == Status.playing;
                off-icon: @image-url("../icons/play.svg");
                on-icon: @image-url("../icons/pause.svg");
                off-offset: 1px;
                icon-size: 14px;
                fg: Theme.t.tx;
                opacity: root.lit || play-control.focused ? 1 : 0;
            }
        }
        if Ui.list-covers : Rectangle {
            width: 40px;
            Artwork {
                width: Ui.compact ? 32px : 40px;
                height: Ui.compact ? 32px : 40px;
                radius: 4px;
                image: root.item.cover;
            }
        }
        VerticalLayout {
            // Zero basis: columns split by stretch only, so they line up across rows.
            horizontal-stretch: 2;
            min-width: 0px;
            preferred-width: 0px;
            spacing: 1px;
            alignment: center;
            Text {
                text: item.title;
                color: root.item.available ? Theme.t.tx : Theme.t.tx2;
                font-size: Type.body;
                font-weight: root.current ? 600 : 500;
                overflow: elide;
            }
            Text { text: item.blocked-reason != "" ? item.blocked-reason : item.artist; color: Theme.t.tx2; font-size: Type.meta; overflow: elide; }
        }
        if root.show-album : Rectangle {
            horizontal-stretch: 1.2;
            min-width: 0px;
            preferred-width: 0px;
            album := Text {
                width: min(self.preferred-width, parent.width);
                x: 0;
                text: root.item.album;
                color: album-touch.has-hover ? Theme.t.tx : Theme.t.tx2;
                font-size: Type.meta;
                overflow: elide;
                vertical-alignment: center;
                album-touch := TouchArea {
                    enabled: root.item.album-id != "";
                    mouse-cursor: pointer;
                    clicked => { Actions.collection(Route.album, root.item.album-id); }
                }
            }
        }
        HorizontalLayout {
            width: TrackColumns.actions;
            spacing: 2px;
            alignment: end;
            // Centre the 32 px buttons in the row, whatever its height.
            padding-top: (TrackColumns.row-height - 32px) / 2;
            padding-bottom: (TrackColumns.row-height - 32px) / 2;
            heart := IconButton {
                icon: @image-url("../icons/heart.svg");
                active-icon: @image-url("../icons/heart-filled.svg");
                label: @tr("Нравится");
                fg: Theme.t.tx2;
                active-fg: Theme.t.tx;
                active: root.item.liked;
                pulse: true;
                reveal: root.item.liked || root.lit;
                clicked => { Actions.like(root.item.id); }
            }
            more := IconButton {
                icon: @image-url("../icons/more.svg");
                label: @tr("Ещё");
                fg: Theme.t.tx2;
                reveal: root.lit;
                clicked => { root.menu(root.item); }
            }
        }
        Text {
            width: TrackColumns.time;
            text: item.duration;
            color: Theme.t.tx2;
            font-size: Type.meta;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}
