import { Theme, Motion, Type } from "../globals/theme.slint";

// Pill button. `primary` is filled with the text colour, `outline` has a hairline border, otherwise it is plain.
export component TextButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary;
    in property <bool> outline;
    in property <bool> enabled: true;
    out property <bool> hovered: touch.has-hover;
    out property <bool> has-focus: focus.has-focus;
    public function focus-button() { focus.focus(); }
    callback clicked();
    private property <color> fg: primary ? Theme.t.bg : Theme.t.tx;
    private property <float> scale: touch.pressed ? 0.96 : 1;
    animate scale { duration: Motion.fast; easing: cubic-bezier(0.2, 0, 0, 1); }
    transform-scale-x: root.scale * 100%;
    transform-scale-y: root.scale * 100%;
    height: 36px;
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    opacity: enabled ? 1 : 0.4;
    background: primary ? (touch.pressed ? Theme.t.tx.with-alpha(0.82) : touch.has-hover ? Theme.t.tx.with-alpha(0.9) : Theme.t.tx)
        : touch.pressed ? Theme.press : touch.has-hover ? Theme.hover : transparent;
    border-width: focus.has-focus ? 2px : outline ? 1px : 0px;
    border-color: focus.has-focus ? (primary ? Theme.t.tx2 : Theme.t.tx) : Theme.t.ln;
    animate background { duration: Motion.fast; }
    HorizontalLayout {
        padding-left: root.icon.width > 0 ? 12px : 16px;
        padding-right: root.icon.width > 0 ? 18px : 16px;
        spacing: 8px;
        alignment: center;
        if root.icon.width > 0 : VerticalLayout {
            alignment: center;
            Image { source: root.icon; colorize: root.fg; width: 16px; height: 16px; }
        }
        Text { text: root.text; color: root.fg; font-size: Type.meta; font-weight: 600; vertical-alignment: center; }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => { if e.text == " " || e.text == "\n" { root.clicked(); return accept; } return reject; }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

// Text-only sidebar item.
export component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 32px;
    border-radius: 6px;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    background: active ? Theme.t.surf : touch.has-hover ? Theme.hover : transparent;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.t.tx;
    animate background { duration: Motion.fast; }
    Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.text;
        color: root.active || touch.has-hover ? Theme.t.tx : Theme.t.tx2;
        font-size: Type.body;
        font-weight: root.active ? 600 : 500;
        vertical-alignment: center;
        overflow: elide;
        animate color { duration: Motion.fast; }
    }
    focus := FocusScope {
        key-pressed(e) => { if e.text == " " || e.text == "\n" { root.clicked(); return accept; } return reject; }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// Row inside a popup menu.
export component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    height: 34px;
    // Concentric with the menu card: its 10 px radius minus 5 px padding.
    border-radius: 5px;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    public function focus-item() { focus.focus(); }
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.t.tx;
    background: touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Motion.fast; }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => { if e.text == " " || e.text == "\n" { root.clicked(); return accept; } return reject; }
    }
    Text { x: 10px; width: parent.width - 20px; text: root.text; color: root.enabled ? Theme.t.tx : Theme.t.tx2; font-size: Type.meta; font-weight: 500; vertical-alignment: center; overflow: elide; }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}
