import { Theme, Motion } from "../globals/theme.slint";
import { GlyphSwap } from "glyph-swap.slint";

// Filled round button; the disc dips while pressed.
export component PlayPause inherits Rectangle {
    in property <bool> playing;
    in property <color> fg: Theme.t.tx;
    in property <color> glyph: Theme.t.bg;
    in property <length> size: 40px;
    callback clicked();
    width: size;
    height: size;
    private property <float> scale: touch.pressed ? 0.96 : 1;
    animate scale { duration: Motion.fast; easing: cubic-bezier(0.2, 0, 0, 1); }
    accessible-role: button;
    accessible-label: playing ? @tr("Пауза") : @tr("Играть");
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: self.width / 2;
        background: root.fg;
        border-width: focus.has-focus ? 2px : 0px;
        border-color: root.glyph;
        transform-scale-x: root.scale * 100%;
        transform-scale-y: root.scale * 100%;
        GlyphSwap {
            width: root.size * 0.45;
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            on: root.playing;
            off-icon: @image-url("../icons/play.svg");
            on-icon: @image-url("../icons/pause.svg");
            fg: root.glyph;
            icon-size: root.size * 0.45;
            off-offset: root.size * 0.03;
        }
    }
    focus := FocusScope {
        key-pressed(e) => { if e.text == " " || e.text == "\n" { root.clicked(); return accept; } return reject; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
