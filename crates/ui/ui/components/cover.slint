import { Theme } from "../globals/theme.slint";
export component Cover inherits Rectangle {
    in property <image> image;
    in property <color> fg: Theme.t.tx;
    callback clicked();
    width: 48px; height: 48px; border-radius: 6px; clip: true;
    accessible-role: button; accessible-label: @tr("Сейчас играет");
    accessible-action-default => { root.clicked(); }
    border-width: focus.has-focus ? 2px : 0px; border-color: fg;
    forward-focus: focus;
    Image { source: root.image; width: parent.width; height: parent.height; image-fit: contain; }
    focus := FocusScope { key-pressed(e) => { if e.text == " " || e.text == "\n" { root.clicked(); return accept; } return reject; } }
    TouchArea { clicked => { focus.focus(); root.clicked(); } }
}
