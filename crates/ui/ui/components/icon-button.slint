import { Theme, Motion } from "../globals/theme.slint";

// Round icon button. `reveal: false` keeps it in the layout but invisible until hover or focus.
// The glyph shrinks while pressed; with `pulse`, it pops when the user switches it on.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <image> active-icon;
    in property <bool> show-mark;
    in property <bool> pulse;
    in property <string> label;
    in property <color> fg: Theme.t.tx;
    in property <color> active-fg: fg;
    in property <bool> active;
    in property <bool> reveal: true;
    in property <length> size: 32px;
    in property <length> icon-size: 16px;
    // Optical correction for asymmetric glyphs such as the play triangle.
    in property <length> icon-offset-x: 0px;
    out property <bool> hovered: touch.has-hover;
    out property <bool> focused: focus.has-focus;
    callback clicked();
    public function focus-button() { focus.focus(); }
    // Set by a click so that only the user's own action pops, not list recycling.
    private property <bool> armed;
    private property <bool> popping;
    private property <bool> reduced: Motion.reduced;
    changed reduced => { if root.reduced { root.popping = false; } }
    private property <float> scale: touch.pressed ? 0.96 : root.popping ? 1.28 : 1;
    animate scale { duration: root.pulse ? Motion.heart : Motion.fast; easing: cubic-bezier(0.2, 0, 0, 1); }
    changed active => {
        if root.armed && root.active && root.pulse && !Motion.reduced {
            root.popping = true;
        }
        if !root.active || Motion.reduced { root.popping = false; }
        root.armed = false;
    }
    function activate() {
        root.armed = true;
        root.clicked();
    }
    width: size;
    height: size;
    border-radius: size / 2;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.activate(); }
    forward-focus: focus;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: fg;
    background: touch.pressed ? fg.with-alpha(0.14) : touch.has-hover ? fg.with-alpha(0.08) : transparent;
    animate background { duration: Motion.fast; }
    Timer {
        interval: 200ms;
        running: root.popping && !Motion.reduced;
        triggered => { root.popping = false; }
    }
    Image {
        source: root.active && root.active-icon.width > 0 ? root.active-icon : root.icon;
        colorize: root.active ? root.active-fg : root.fg;
        width: root.icon-size;
        height: root.icon-size;
        x: (parent.width - self.width) / 2 + root.icon-offset-x;
        y: (parent.height - self.height) / 2;
        opacity: root.reveal || root.focused || root.hovered ? 1 : 0;
        transform-scale-x: root.scale * 100%;
        transform-scale-y: root.scale * 100%;
        animate opacity { duration: Motion.fast; }
    }
    if root.active && root.show-mark : Rectangle {
        width: 4px;
        height: 4px;
        border-radius: 2px;
        x: (parent.width - self.width) / 2;
        y: parent.height - 7px;
        background: root.active-fg;
    }
    focus := FocusScope {
        key-pressed(e) => { if e.text == " " || e.text == "\n" { root.activate(); return accept; } return reject; }
    }
    // 4 px taller than the circle for a 40 px hit area; neighbours are only side by side.
    touch := TouchArea {
        y: -4px;
        height: parent.height + 8px;
        mouse-cursor: pointer;
        clicked => { root.activate(); }
    }
}
