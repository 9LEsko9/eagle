import "fonts/Inter-subset.ttf";
import { ListView } from "std-widgets.slint";
import { Theme, ThemeMode, Type, Motion, Layout } from "globals/theme.slint";
import { Player, Library, Ui, Actions, Route, Storage, DownloadItem, QueueItem } from "globals/bridge.slint";
import { NavItem } from "components/button.slint";
import { CreatePlaylistDialog } from "components/create-playlist-dialog.slint";
import { IconButton } from "components/icon-button.slint";
import { CollectionScreen } from "screens/collection.slint";
import { SettingsScreen } from "screens/settings.slint";
import { LoginScreen } from "screens/login.slint";
import { ArtistScreen } from "screens/artist.slint";
import { PlayerBar } from "player/player-bar.slint";
import { NowPlayingPanel, NowPlayingCard } from "player/now-playing-panel.slint";
import { Loading, LoadingDelays } from "globals/loading.slint";
export { Theme, ThemeMode, Motion, Type, Player, Library, Ui, Actions, Route, Storage, DownloadItem, QueueItem, Loading }

component Sidebar inherits VerticalLayout {
    // Every navigation also closes the drawer on narrow windows.
    function go(route: Route) {
        Ui.drawer-open = false;
        Ui.create-playlist = false;
        Actions.open(route);
    }
    width: 208px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 24px;
    padding-bottom: 20px;
    spacing: 2px;
    HorizontalLayout {
        padding-left: 10px;
        height: 52px;
        Text { text: "eagle"; color: Theme.t.tx; font-size: 19px; font-weight: 600; letter-spacing: -0.6px; vertical-alignment: top; }
    }
    NavItem { text: @tr("Медиатека"); active: (Ui.route == Route.library || Ui.route == Route.albums || Ui.route == Route.artists); clicked => { root.go(Route.library); } }
    NavItem { text: @tr("Сохранённое"); active: Ui.route == Route.saved; clicked => { root.go(Route.saved); } }
    NavItem { text: @tr("История"); active: Ui.route == Route.history; clicked => { root.go(Route.history); } }
    if Ui.signed-in : NavItem { text: @tr("Моя волна"); active: Ui.route == Route.radio; clicked => { root.go(Route.radio); } }
    NavItem { text: @tr("Поиск"); active: Ui.route == Route.search; clicked => { root.go(Route.search); } }
    if Ui.signed-in : HorizontalLayout {
        padding-left: 10px;
        height: 46px;
        Text { text: @tr("Плейлисты"); color: Theme.t.tx2; font-size: Type.small; font-weight: 500; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        // Centred on the label: a fixed-size child of a HorizontalLayout sits at the top otherwise.
        VerticalLayout {
            alignment: center;
            IconButton { private property <bool> dialog-open: Ui.create-playlist; changed dialog-open => { if !self.dialog-open && !Layout.compact { self.focus-button(); } } size: 28px; icon-size: 16px; icon: @image-url("icons/plus.svg"); label: @tr("Создать плейлист"); clicked => { Ui.drawer-open = false; Ui.playlist-name = ""; Ui.error = ""; Ui.create-playlist = true; } }
        }
    }
    if Ui.signed-in : Rectangle { height: 6px; }
    ListView {
        vertical-stretch: 1;
        min-height: 0px;
        for playlist in Library.playlists : NavItem {
            text: playlist.title;
            active: Ui.route == Route.playlist && playlist.id == Library.header-id;
            clicked => {
                Ui.drawer-open = false;
                Ui.create-playlist = false;
                Actions.collection(Route.playlist, playlist.id);
            }
        }
    }
    if !Ui.signed-in : NavItem { text: @tr("Войти"); active: Ui.route == Route.login; clicked => { root.go(Route.login); } }
    NavItem { text: @tr("Настройки"); active: Ui.route == Route.settings; clicked => { root.go(Route.settings); } }
}

export component DesktopWindow inherits Window {
    title: "eagle";
    icon: @image-url("../assets/brand/icon-256.png");
    preferred-width: 1280px;
    preferred-height: 880px;
    min-width: 560px;
    min-height: 480px;
    background: Theme.t.bg;
    default-font-family: "Inter";
    default-font-size: Type.body;
    init => { Layout.width = self.width; }
    changed width => {
        Layout.width = self.width;
        if !Layout.compact { Ui.drawer-open = false; }
    }
    private property <float> panel-lifetime: Ui.panel-open ? 1 : 0;
    animate panel-lifetime { duration: Ui.panel-open ? Motion.panel-in : Motion.panel-out; }
    changed panel-lifetime => {
        if root.panel-lifetime == 0 || root.panel-lifetime == 1 {
            Actions.panel-content(Ui.panel-open);
        }
    }
    // The drawer slides in 24 px and fades; it leaves the tree once the exit has finished.
    private property <float> drawer-lifetime: Ui.drawer-open ? 1 : 0;
    animate drawer-lifetime { duration: Motion.base; }
    private property <length> drawer-offset: Ui.drawer-open ? 0px : -24px;
    animate drawer-offset { duration: Motion.base; easing: cubic-bezier(0.2, 0, 0, 1); }
    private property <length> bar-height: 80px;
    private property <bool> dialog-open: Ui.create-playlist;
    changed dialog-open => { if !self.dialog-open && !Ui.signed-in && !Layout.compact { keys.focus(); } }
    keys := FocusScope {
        VerticalLayout {
            spacing: 0;
            HorizontalLayout {
                spacing: 0;
                if !Layout.compact : Sidebar { }
                VerticalLayout {
                    min-width: 0px;
                    padding-left: Layout.compact ? 20px : Layout.wide ? 48px : 32px;
                    padding-right: Layout.compact ? 20px : Layout.wide ? 48px : 32px;
                    padding-top: Layout.compact ? 12px : 40px;
                    padding-bottom: 0px;
                    spacing: Layout.compact ? 8px : 16px;
                    if Layout.compact : HorizontalLayout {
                        alignment: start;
                        IconButton { private property <bool> dialog-open: Ui.create-playlist; changed dialog-open => { if !self.dialog-open { self.focus-button(); } } size: 36px; icon-size: 20px; icon: @image-url("icons/menu.svg"); label: @tr("Меню"); clicked => { Ui.drawer-open = true; } }
                    }
                    // Lists use the whole width; forms cap their own width inside.
                    VerticalLayout {
                        vertical-stretch: 1;
                        if (Ui.route == Route.saved || Ui.route == Route.history || Ui.route == Route.library || Ui.route == Route.search || Ui.route == Route.album || Ui.route == Route.playlist || Ui.route == Route.albums || Ui.route == Route.artists || Ui.route == Route.radio) : CollectionScreen { }
                        if Ui.route == Route.artist : ArtistScreen { }
                        if Ui.route == Route.login : LoginScreen { }
                        if Ui.route == Route.settings : SettingsScreen { }
                    }
                    if Ui.error != "" && !Ui.create-playlist : Rectangle {
                        border-radius: 10px;
                        background: Theme.t.surf;
                        border-width: 1px;
                        border-color: Theme.t.ln;
                        HorizontalLayout {
                            padding: 12px;
                            Text { text: Ui.error; color: Theme.t.tx; font-size: Type.meta; wrap: word-wrap; }
                        }
                    }
                    Rectangle { height: 16px; }
                }
                if !Layout.narrow : NowPlayingPanel { }
            }
            PlayerBar { height: root.bar-height; }
        }
        // Floating «Сейчас играет» on windows too narrow for a third column.
        if Layout.narrow && (Ui.panel-open || root.panel-lifetime > 0) : NowPlayingCard {
            floating: true;
            x: parent.width - self.width - 24px;
            y: 16px;
            height: parent.height - root.bar-height - 32px;
        }
        // Sidebar drawer: a click outside closes it.
        if Layout.compact && Ui.drawer-open : TouchArea {
            width: parent.width;
            height: parent.height - root.bar-height;
            x: 0;
            y: 0;
            clicked => { Ui.drawer-open = false; }
        }
        if Layout.compact && (Ui.drawer-open || root.drawer-lifetime > 0) : Rectangle {
            x: root.drawer-offset;
            y: 0;
            width: 224px;
            height: parent.height - root.bar-height;
            opacity: root.drawer-lifetime;
            background: Theme.t.bg;
            border-width: 0px;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000059;
            TouchArea { }
            Sidebar { width: parent.width; height: parent.height; }
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.t.ln; }
        }
        CreatePlaylistDialog { x: 0; y: 0; width: parent.width; height: parent.height - root.bar-height; }
        key-pressed(e) => {
            if Ui.create-playlist {
                if e.text == Key.Escape { Ui.create-playlist = false; return accept; }
                return reject;
            }
            if e.text == " " { Actions.toggle-play(); return accept; }
            if e.text == Key.LeftArrow { Actions.seek(max(0, Player.shown - 5)); return accept; }
            if e.text == Key.RightArrow { Actions.seek(min(Player.length, Player.shown + 5)); return accept; }
            if e.text == Key.UpArrow { Actions.set-volume(min(1, Player.volume + 0.05)); return accept; }
            if e.text == Key.DownArrow { Actions.set-volume(max(0, Player.volume - 0.05)); return accept; }
            if e.modifiers.control && e.text == "f" { Actions.open(Route.search); return accept; }
            if e.text == Key.Escape {
                if Ui.drawer-open { Ui.drawer-open = false; } else { Ui.panel-open = false; }
                return accept;
            }
            return reject;
        }
    }
    forward-focus: keys;
    LoadingDelays { }
}
