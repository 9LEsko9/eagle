// SPDX-License-Identifier: GPL-3.0-or-later
import { Theme, Type, Layout } from "../globals/theme.slint";
import { Library, Ui, Actions } from "../globals/bridge.slint";
import { TrackRowView } from "../components/track-row.slint";
import { TextButton } from "../components/button.slint";
import { CardGrid } from "../components/cards.slint";
import { Artwork } from "../components/cover.slint";
import { SkeletonRows } from "../components/skeleton.slint";
import { SkeletonBar } from "../components/spinner.slint";
import { Loading } from "../globals/loading.slint";
import { TrackMenu, TrackTableHeader } from "collection.slint";

component SectionHeading inherits Text {
    color: Theme.t.tx;
    font-size: Type.lead;
    font-weight: 700;
    letter-spacing: -0.3px;
    height: 48px;
    vertical-alignment: bottom;
}

// One scrolling page: header, popular tracks (a handful, so not virtualised) and the
// discography grid, whose artwork loads as it scrolls into view.
export component ArtistScreen inherits Flickable {
    private property <length> cover-size: Layout.compact ? 112px : 160px;
    viewport-height: body.preferred-height + 24px;
    body := VerticalLayout {
        width: root.width;
        spacing: 0px;
        HorizontalLayout {
            spacing: 24px;
            if !Layout.compact || Library.cover.width > 0 : VerticalLayout {
                alignment: end;
                Artwork {
                    width: root.cover-size;
                    height: root.cover-size;
                    radius: root.cover-size / 2;
                    image: Library.cover;
                }
            }
            VerticalLayout {
                alignment: end;
                spacing: 0px;
                Text { text: @tr("Исполнитель"); color: Theme.t.tx2; font-size: Type.meta; font-weight: 500; }
                // A blank title keeps the height; a skeleton bar stands in while the page loads.
                Rectangle {
                    height: artist-title.height;
                    artist-title := Text {
                        width: parent.width;
                        text: Library.title != "" ? Library.title : " ";
                        color: Theme.t.tx;
                        font-size: Layout.compact ? Type.title : Type.display;
                        font-weight: 700;
                        letter-spacing: -0.8px;
                        overflow: elide;
                        height: self.preferred-height + 10px;
                        vertical-alignment: center;
                    }
                    if Library.title == "" && Loading.page : SkeletonBar {
                        x: 0px;
                        y: (parent.height - self.height) / 2;
                        width: min(280px, parent.width);
                        height: Layout.compact ? 20px : 28px;
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    padding-top: 12px;
                    alignment: start;
                    TextButton { text: @tr("Слушать"); icon: @image-url("../icons/play.svg"); primary: true; enabled: Library.tracks.length > 0; clicked => { Actions.play-all(false); } }
                    if Library.likeable : TextButton {
                        text: Library.liked ? @tr("Вы подписаны") : @tr("Нравится");
                        icon: Library.liked ? @image-url("../icons/heart-filled.svg") : @image-url("../icons/heart.svg");
                        outline: true;
                        clicked => { Actions.like-collection(); }
                    }
                }
            }
        }
        // Placeholder for the first load: a section heading bar and a few track rows.
        if Loading.page && Library.tracks.length == 0 && Library.cards.length == 0 : VerticalLayout {
            spacing: 8px;
            Rectangle {
                height: 48px;
                SkeletonBar { x: 0px; y: parent.height - self.height; width: 180px; height: 18px; }
            }
            SkeletonRows { count: 5; }
        }
        if Library.tracks.length > 0 : SectionHeading { text: @tr("Популярные треки"); }
        if Library.tracks.length > 0 : Rectangle { height: 8px; }
        if Library.tracks.length > 0 : TrackTableHeader { }
        if Library.tracks.length > 0 : menu := TrackMenu {
            height: Library.tracks.length * 54px + 6px;
            VerticalLayout {
                padding-top: 6px;
                for item[index] in Library.tracks : TrackRowView {
                    item: item;
                    number: index + 1;
                    menu(item) => { menu.open(item, self.y, index); }
                }
            }
        }
        if Library.cards.length > 0 : SectionHeading { text: @tr("Альбомы"); }
        if Library.cards.length > 0 : Rectangle { height: 16px; }
        if Library.cards.length > 0 : grid := CardGrid {
            cards: Library.cards;
            top: -root.viewport-y - self.y;
            view-height: root.height;
            anchor-changed(top) => { root.viewport-y = -top - self.y; }
        }
    }
}
