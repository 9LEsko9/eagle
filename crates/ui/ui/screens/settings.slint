import { ListView } from "std-widgets.slint";
// SPDX-License-Identifier: GPL-3.0-or-later
import { Theme, ThemeMode, Type, Motion, Layout } from "../globals/theme.slint";
import { Ui, Actions, Route, Player, Status, Storage } from "../globals/bridge.slint";
import { TextButton } from "../components/button.slint";
import { Segmented, Switch, Field } from "../components/controls.slint";
import { Artwork } from "../components/cover.slint";
import { ServicesSection } from "../components/services.slint";
import { PlayPause } from "../components/play-pause.slint";

component SectionTitle inherits Text {
    color: Theme.t.tx2;
    font-size: Type.small;
    font-weight: 600;
    height: 44px;
    vertical-alignment: bottom;
}

// Label (with optional hint) on the left, control on the right, hairline below.
component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    min-height: 60px;
    HorizontalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 24px;
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: 2px;
            alignment: center;
            Text { text: root.title; color: Theme.t.tx; font-size: Type.body; font-weight: 500; }
            if root.hint != "" : Text { text: root.hint; color: Theme.t.tx2; font-size: Type.meta; wrap: word-wrap; }
        }
        VerticalLayout {
            alignment: center;
            @children
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.t.ln; }
}

// Static sample row in theme colours, mirroring the track list.
component SampleRow inherits HorizontalLayout {
    in property <string> number;
    in property <string> title;
    in property <string> artist;
    in property <string> time;
    in property <bool> current;
    height: 50px;
    spacing: 12px;
    Rectangle {
        width: 24px;
        Text { text: root.number; color: Theme.t.tx2; font-size: Type.meta; horizontal-alignment: center; vertical-alignment: center; visible: !root.current; }
        Image { source: @image-url("../icons/speaker.svg"); colorize: Theme.t.tx; width: 16px; height: 16px; visible: root.current; }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        min-width: 0px;
        alignment: center;
        spacing: 1px;
        Text { text: root.title; color: Theme.t.tx; font-size: Type.body; font-weight: root.current ? 600 : 500; overflow: elide; }
        Text { text: root.artist; color: Theme.t.tx2; font-size: Type.meta; overflow: elide; }
    }
    Text { text: root.time; color: Theme.t.tx2; font-size: Type.meta; vertical-alignment: center; }
}

// Live preview: theme, text size and the cover-tinted player react to every setting.
component AppearancePreview inherits Rectangle {
    border-radius: 14px;
    background: Theme.t.bg;
    border-width: 1px;
    border-color: Theme.t.ln;
    animate background { duration: Motion.slow; }
    VerticalLayout {
        padding: 16px;
        spacing: 4px;
        Text { text: @tr("Предпросмотр"); color: Theme.t.tx2; font-size: Type.small; font-weight: 600; height: 28px; vertical-alignment: top; }
        SampleRow { number: "1"; title: Player.title != "" ? Player.title : @tr("Магистраль"); artist: Player.title != "" ? Player.artist : @tr("Шум волн"); time: "4:22"; current: true; }
        SampleRow { number: "2"; title: @tr("Северный свет"); artist: @tr("Мира Вольская"); time: "3:42"; }
        Rectangle { height: 8px; }
        Rectangle {
            height: 72px;
            border-radius: 12px;
            background: Player.colors.bg;
            animate background { duration: Motion.slow; }
            HorizontalLayout {
                padding: 12px;
                spacing: 12px;
                Artwork { image: Player.cover; width: 48px; height: 48px; radius: 6px; outline: Player.colors.tx.with-alpha(0.1); }
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    alignment: center;
                    spacing: 1px;
                    Text { text: Player.title != "" ? Player.title : @tr("Магистраль"); color: Player.colors.tx; font-size: Type.body; font-weight: 600; overflow: elide; }
                    Text { text: Player.title != "" ? Player.artist : @tr("Шум волн"); color: Player.colors.tx2; font-size: Type.meta; overflow: elide; }
                }
                VerticalLayout {
                    alignment: center;
                    PlayPause { size: 36px; playing: Player.status == Status.playing; fg: Player.colors.tx; glyph: Player.colors.bg; clicked => { Actions.toggle-play(); } }
                }
            }
        }
        Text {
            text: @tr("Цвет плеера берётся из обложки текущего трека.");
            color: Theme.t.tx2;
            font-size: Type.small;
            wrap: word-wrap;
            height: self.preferred-height + 8px;
            vertical-alignment: bottom;
        }
    }
}

// Half of a theme tile: paper (0), graphite (1) or OLED (2), with a mini track list and bar.
component MiniHalf inherits Rectangle {
    in property <int> kind;
    clip: true;
    background: root.kind == 0 ? #fafaf7 : root.kind == 2 ? #000000 : #121214;
    Rectangle { x: 8px; y: 10px; width: parent.width * 0.6; height: 4px; border-radius: 2px; background: root.kind == 0 ? #151517 : #f2f2f4; }
    Rectangle { x: 8px; y: 20px; width: parent.width * 0.4; height: 4px; border-radius: 2px; background: root.kind == 0 ? #d6d6d0 : root.kind == 2 ? #2a2a2e : #3a3a40; }
    Rectangle { x: 0; y: parent.height - 22px; width: parent.width; height: 22px; background: root.kind == 0 ? #f0f0eb : root.kind == 2 ? #0f0f11 : #1a1a1d; }
}

// Theme card as in the mockup: a 72 px preview, a 2 px ring when chosen, and a caption.
component ThemeTile inherits Rectangle {
    in property <string> name;
    in property <int> kind;
    in property <bool> auto;
    in property <bool> selected;
    callback clicked();
    horizontal-stretch: 1;
    preferred-width: 0px;
    min-width: 0px;
    accessible-role: button;
    accessible-label: name;
    accessible-action-default => { root.clicked(); }
    VerticalLayout {
        spacing: 6px;
        Rectangle {
            height: 80px;
            if root.selected : Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                border-radius: 16px;
                border-width: 2px;
                border-color: Theme.t.tx;
            }
            Rectangle {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: 72px;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.t.ln;
                clip: true;
                HorizontalLayout {
                    MiniHalf { horizontal-stretch: 1; kind: root.kind; }
                    if root.auto : MiniHalf { horizontal-stretch: 1; kind: 1; }
                }
            }
        }
        Text {
            text: root.name;
            color: Theme.t.tx;
            font-size: Type.small;
            font-weight: root.selected ? 700 : 500;
            horizontal-alignment: center;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component SettingsScreen inherits Flickable {
    private property <string> remove-id;
    private property <string> move-destination;
    private property <bool> confirm-move;
    // Derived from the window (not this element) so the decision cannot feed back into layout.
    private property <length> content-width: Layout.width
        - (Layout.compact ? 0px : 208px)
        - (Ui.panel-open && !Layout.narrow ? 336px : 0px)
        - (Layout.compact ? 40px : 80px);
    // Wide: settings and a sticky preview side by side, the pair centred in the free space.
    private property <bool> split: content-width >= 960px;
    viewport-height: body.preferred-height + 24px;
    body := HorizontalLayout {
        width: root.width;
        alignment: root.split ? center : start;
        VerticalLayout {
            max-width: root.split ? 1240px : 680px;
            horizontal-stretch: 1;
            alignment: start;
            spacing: 0px;
            Text { text: @tr("Настройки"); color: Theme.t.tx; font-size: Layout.compact ? Type.title : Type.display; font-weight: 700; letter-spacing: -0.8px; }
            if !root.split : VerticalLayout {
                padding-top: 20px;
                AppearancePreview { }
            }
            HorizontalLayout {
                spacing: 48px;
                alignment: stretch;
                VerticalLayout {
                    horizontal-stretch: 1.6;
                    min-width: 0px;
                    alignment: start;
                    spacing: 0px;
                    SectionTitle { text: @tr("Сервисы"); }
                    ServicesSection { }
                    SectionTitle { text: @tr("Оформление"); }
                    VerticalLayout {
                        padding-top: 12px;
                        padding-bottom: 16px;
                        spacing: 4px;
                        min-height: 60px;
                        Text { text: @tr("Тема"); color: Theme.t.tx; font-size: Type.body; font-weight: 500; }
                        Text { text: @tr("«Авто» следует системной светлой или тёмной теме"); color: Theme.t.tx2; font-size: Type.meta; wrap: word-wrap; }
                        HorizontalLayout {
                            padding-top: 10px;
                            spacing: 10px;
                            ThemeTile {
                                name: @tr("Авто");
                                kind: 0;
                                auto: true;
                                selected: Theme.mode == ThemeMode.auto;
                                clicked => { Theme.mode = ThemeMode.auto; Actions.preferences-changed(); }
                            }
                            ThemeTile {
                                name: @tr("Графит");
                                kind: 1;
                                selected: Theme.mode == ThemeMode.graphite;
                                clicked => { Theme.mode = ThemeMode.graphite; Actions.preferences-changed(); }
                            }
                            ThemeTile {
                                name: @tr("Бумага");
                                kind: 0;
                                selected: Theme.mode == ThemeMode.paper;
                                clicked => { Theme.mode = ThemeMode.paper; Actions.preferences-changed(); }
                            }
                            ThemeTile {
                                name: "OLED";
                                kind: 2;
                                selected: Theme.mode == ThemeMode.oled;
                                clicked => { Theme.mode = ThemeMode.oled; Actions.preferences-changed(); }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.t.ln; }
                    SettingRow {
                        title: @tr("Цвет плеера");
                        hint: @tr("Плеер и панель окрашиваются в оттенок обложки");
                        Segmented {
                            options: [@tr("Выкл"), @tr("Мягкий"), @tr("Яркий")];
                            selected: Theme.tint;
                            picked(i) => { Theme.tint = i; Actions.preferences-changed(); }
                        }
                    }
                    SettingRow {
                        title: @tr("Размер текста");
                        Segmented {
                            options: [@tr("Мелкий"), @tr("Обычный"), @tr("Крупный")];
                            selected: Type.scale < 0.95 ? 0 : Type.scale > 1.05 ? 2 : 1;
                            picked(i) => { Type.scale = i == 0 ? 0.9 : i == 2 ? 1.15 : 1; Actions.preferences-changed(); }
                        }
                    }
                    SettingRow {
                        title: @tr("Обложки в списках");
                        hint: @tr("На десктопе обложка видна только в плеере");
                        Switch { label: @tr("Обложки в списках"); checked: Ui.list-covers; toggled => { Ui.list-covers = !Ui.list-covers; Actions.list-covers-changed(); Actions.preferences-changed(); } }
                    }
                    SettingRow {
                        title: @tr("Уменьшить движение");
                        hint: @tr("Отключает анимации и перетекание цветов");
                        Switch { label: @tr("Уменьшить движение"); checked: Motion.reduced; toggled => { Motion.reduced = !Motion.reduced; Actions.preferences-changed(); } }
                    }
                    SettingRow {
                        title: @tr("Компактные строки");
                        hint: @tr("Больше треков на экране");
                        Switch { label: @tr("Компактные строки"); checked: Ui.compact; toggled => { Ui.compact = !Ui.compact; Actions.preferences-changed(); } }
                    }
                    SectionTitle { text: @tr("Хранилище"); }
                    SettingRow {
                        title: @tr("Загрузки в лимитной сети");
                        hint: Storage.network-hint;
                        Switch { label: @tr("Разрешать загрузки в лимитной сети"); checked: Storage.allow-metered; toggled => { Actions.allow-metered(!Storage.allow-metered); } }
                    }
                    SettingRow {
                        title: @tr("Аудиофайлы");
                        hint: @tr("Кэш: ") + Storage.cache-usage + @tr(" · Сохранённое: ") + Storage.saved-usage;
                    }
                    SettingRow { title: @tr("Временные загрузки"); hint: Storage.staging-usage; }
                    SettingRow { title: @tr("Обложки, метаданные и прочие файлы"); hint: Storage.other-usage; }
                    SettingRow { title: @tr("Всего в управляемой папке"); hint: Storage.total-usage; }
                    SettingRow {
                        title: @tr("Лимит кэша");
                        hint: @tr("Сохранённое не входит в лимит. Новый лимит применяется при записи в кэш.");
                        Segmented { options: [@tr("512 МиБ"), @tr("2 ГиБ"), @tr("8 ГиБ")]; selected: Storage.cache-limit; picked(i) => { Actions.cache-limit(i); } }
                    }
                    SettingRow { title: @tr("Управляемая папка"); hint: Storage.folder; }
                    SettingRow {
                        title: @tr("Перенести хранилище");
                        hint: Storage.moving ? @tr("Перенос: новые записи приостановлены. Исходные файлы сохраняются.") : @tr("Выберите существующую пустую папку. Музыка остановится; файлы проверяются перед переключением.");
                        VerticalLayout {
                            spacing: 8px;
                            Field { placeholder: @tr("Полный путь к пустой папке"); text <=> root.move-destination; }
                            TextButton { text: root.confirm-move ? @tr("Подтвердить перенос") : @tr("Перенести"); enabled: !Storage.moving && root.move-destination != ""; clicked => { if root.confirm-move { Actions.move-storage(root.move-destination); root.confirm-move = false; } else { root.confirm-move = true; } } }
                        }
                    }
                    SectionTitle { text: @tr("Сохранение офлайн"); }
                    SettingRow {
                        title: @tr("Качество новых загрузок");
                        hint: @tr("Выбор относится к новым заданиям. Недоступное качество будет отмечено ошибкой.");
                        Segmented { options: [@tr("До 192"), @tr("320 кбит/с")]; selected: Storage.quality; picked(i) => { Storage.quality = i; Actions.preferences-changed(); } }
                    }
                    SettingRow {
                        title: @tr("Загрузки");
                        hint: @tr("Два задания одновременно. Пауза и отмена сохраняются после перезапуска.");
                        TextButton { text: @tr("Обновить"); clicked => { Actions.downloads(); } }
                    }
                    if Storage.jobs.length == 0 : Text {
                        text: @tr("Загрузок пока нет. Выберите «Сохранить офлайн» в меню трека.");
                        color: Theme.t.tx2; font-size: Type.meta; wrap: word-wrap;
                    }
                    if Storage.jobs.length > 0 : ListView {
                    height: min(440px, Storage.jobs.length * 132px);
                    for job in Storage.jobs : VerticalLayout {
                        height: 132px;
                        padding-top: 12px; padding-bottom: 12px; spacing: 4px;
                        Text { text: job.track; color: Theme.t.tx; font-size: Type.body; overflow: elide; }
                        Text { text: job.quality + " · " + job.status; color: Theme.t.tx2; font-size: Type.meta; }
                        if job.error != "" : Text { text: job.error; color: Theme.t.tx2; font-size: Type.meta; wrap: word-wrap; }
                        HorizontalLayout {
                            alignment: start; spacing: 8px;
                            if job.saved && root.remove-id != job.id : TextButton { text: @tr("Удалить сохранённое"); clicked => { root.remove-id = job.id; } }
                            if job.saved && root.remove-id == job.id : TextButton { text: @tr("Подтвердить удаление"); clicked => { Actions.remove-saved(job.id); root.remove-id = ""; } }
                            if job.saved && root.remove-id == job.id : TextButton { text: @tr("Отмена"); clicked => { root.remove-id = ""; } }
                            if job.pausable : TextButton { text: @tr("Пауза"); clicked => { Actions.download-control(job.id, 0); } }
                            if job.retryable : TextButton { text: @tr("Продолжить"); clicked => { Actions.download-control(job.id, 1); } }
                            if job.cancellable : TextButton { text: @tr("Отменить"); clicked => { Actions.download-control(job.id, 2); } }
                        }
                    }
                    }
                    SectionTitle { text: @tr("Система"); }
                    SettingRow {
                        title: @tr("Завершать при закрытии окна");
                        hint: @tr("По умолчанию музыка и загрузки продолжаются в фоне");
                        Switch { label: @tr("Завершать при закрытии"); checked: Ui.close-exits; toggled => { Ui.close-exits = !Ui.close-exits; Actions.preferences-changed(); } }
                    }
                    SettingRow {
                        title: @tr("Запускать при входе в систему");
                        hint: @tr("Системная регистрация автозапуска");
                        Switch { label: @tr("Автозапуск"); checked: Ui.autostart; toggled => { Actions.autostart(!Ui.autostart); } }
                    }
                    Text {
                        text: @tr("При закрытии окна приложение выходит.");
                        color: Theme.t.tx2;
                        font-size: Type.meta;
                        height: 44px;
                        vertical-alignment: center;
                    }
                }
                if root.split : VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 340px;
                    max-width: 460px;
                    alignment: start;
                    padding-top: 44px;
                    AppearancePreview { }
                }
            }
        }
    }
}
